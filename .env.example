# Webizon — Environment Variables (copy to .env and fill in values)

# ============================================================================
# ENVIRONMENT
# ============================================================================
ENVIRONMENT=local
LOG_LEVEL=INFO

# ============================================================================
# POSTGRESQL
# ============================================================================
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=webizon
POSTGRES_USER=webizon
POSTGRES_PASSWORD=change_me_in_production

# PgBouncer (local dev connects directly to Postgres; prod goes via PgBouncer)
PGBOUNCER_HOST=pgbouncer
PGBOUNCER_PORT=6432

# ============================================================================
# REDIS
# ============================================================================
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=

# ============================================================================
# KAFKA
# ============================================================================
KAFKA_BOOTSTRAP_SERVERS=kafka:29092
KAFKA_SCHEMA_REGISTRY_URL=http://schema-registry:8081

# ============================================================================
# CLICKHOUSE
# ============================================================================
CLICKHOUSE_HOST=clickhouse
CLICKHOUSE_PORT=8123
CLICKHOUSE_DB=webizon_analytics
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=

# ============================================================================
# CENTRIFUGO (Real-time server)
# ============================================================================
CENTRIFUGO_URL=http://centrifugo:8000
CENTRIFUGO_API_URL=http://centrifugo:8000/api
CENTRIFUGO_API_KEY=dev_api_key_change_me
CENTRIFUGO_TOKEN_HMAC_SECRET=dev_hmac_secret_change_me
CENTRIFUGO_ADMIN_PASSWORD=admin

# ============================================================================
# KEYCLOAK (Auth)
# ============================================================================
KEYCLOAK_URL=http://keycloak:8180
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin
KEYCLOAK_REALM=webizon
KEYCLOAK_CLIENT_ID=webizon-frontend
KEYCLOAK_CLIENT_SECRET=dev_client_secret

# Webizon API uses the JWK Set URI for token validation
KEYCLOAK_ISSUER_URI=http://keycloak:8180/realms/webizon
KEYCLOAK_JWK_SET_URI=http://keycloak:8180/realms/webizon/protocol/openid-connect/certs

# ============================================================================
# MINIO (S3-compatible, dev only)
# ============================================================================
MINIO_ENDPOINT=http://minio:9000
MINIO_PUBLIC_ENDPOINT=http://localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET_COVERS=webizon-covers
MINIO_BUCKET_CTA=webizon-cta-files
MINIO_BUCKET_RECORDINGS=webizon-recordings
MINIO_BUCKET_INVOICES=webizon-invoices

# ============================================================================
# BACKEND API
# ============================================================================
SPRING_PROFILES_ACTIVE=local
SERVER_PORT=8080
CORS_ALLOWED_ORIGINS=http://localhost:3000

# ============================================================================
# FRONTEND
# ============================================================================
NUXT_PUBLIC_API_BASE=/api/backend
NUXT_BACKEND_INTERNAL_URL=http://backend:8080
NUXT_PUBLIC_CENTRIFUGO_URL=ws://localhost:8000/connection/websocket
NUXT_PUBLIC_AUTH_SERVER=http://localhost:8180
NUXT_PUBLIC_AUTH_CLIENT_ID=webizon-frontend
NUXT_PUBLIC_AUTH_REALM=webizon

# ============================================================================
# BILLING PROVIDERS
# ============================================================================
# CloudPayments Kazakhstan (primary)
CLOUDPAYMENTS_PUBLIC_ID=
CLOUDPAYMENTS_API_SECRET=
CLOUDPAYMENTS_WEBHOOK_SECRET=

# Stripe (secondary, international)
STRIPE_PUBLIC_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# ============================================================================
# OBSERVABILITY
# ============================================================================
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4317
OTEL_SERVICE_NAME=webizon-api
PROMETHEUS_SCRAPE_PORT=9090
