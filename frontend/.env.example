# Browser-exposed (must be prefixed with NUXT_PUBLIC_)
NUXT_PUBLIC_API_BASE=/api/backend
NUXT_PUBLIC_CENTRIFUGO_URL=ws://localhost:8000/connection/websocket
NUXT_PUBLIC_KEYCLOAK_URL=http://localhost:8180
NUXT_PUBLIC_KEYCLOAK_REALM=webizon
NUXT_PUBLIC_KEYCLOAK_CLIENT_ID=webizon-frontend

# Server-only (Nitro proxy target inside docker network)
NUXT_BACKEND_INTERNAL_URL=http://backend:8080
